# Copiá este archivo como ".env" y llená los valores reales que te da la
# consola de Firebase al crear tu proyecto (Configuración del proyecto >
# Tus apps > SDK setup and configuration).
#
# IMPORTANTE: .env está en .gitignore y NUNCA debe subirse a GitHub.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fotos de producto: usamos Cloudinary (gratis, sin tarjeta) en vez de
# Firebase Storage, porque Firebase ahora pide el plan de pago (Blaze)
# incluso para uso mínimo de Storage.
# Sacás estos dos valores al crear tu cuenta gratuita en cloudinary.com
# (ver la guía paso a paso para el detalle).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Correo del único usuario que puede ver/usar el panel de administración.
VITE_ADMIN_EMAIL=jmonteroa1@ucenfotec.ac.cr

# Número de WhatsApp (con código de país, sin +, sin espacios) al que
# llegará el mensaje del pedido. 502 = Guatemala.
VITE_WHATSAPP_NUMBER=50263461211
